# OpenAI API key used only by the backend.
# Copy this file to .env.local when the application is implemented.
OPENAI_API_KEY=

# Auth.js. Login is available exclusively through Google OAuth.
# Generate AUTH_SECRET once with Node:
# node -e "console.log(require('node:crypto').randomBytes(32).toString('base64'))"
AUTH_SECRET=
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=
# Required when serving behind a trusted reverse proxy, such as Render.
AUTH_TRUST_HOST=true
# A URL PUBLICA do servico. Em producao NAO e opcional, e AUTH_TRUST_HOST nao
# substitui: atras do proxy da Render o host original nao chega, o Auth.js
# conclui que mora em https://localhost:10000 e manda isso ao Google como
# redirect_uri -- que recusa com redirect_uri_mismatch. Sem barra no fim.
# Vazia em desenvolvimento (localhost e o host de verdade).
AUTH_URL=
# Comma-separated Google accounts allowed to open /admin/* screens.
NEXODOC_ADMIN_EMAILS=

# Development-only shortcut for automated/local QA. Ignored in production.
NEXODOC_DEV_AUTH=false
NEXODOC_DEV_AUTH_EMAIL=
NEXODOC_DEV_AUTH_NAME=Usuario Dev

# Liga a tela do Nexo. NEXT_PUBLIC_* e EMBUTIDA NA COMPILACAO -- mudar isto no
# painel da Render depois do build nao tem efeito nenhum sobre o pacote servido.
# No deploy quem manda e o ARG do Dockerfile (ja vem true).
NEXT_PUBLIC_NEXO_ENABLED=true

# --- Herdadas do arranjo Vercel(app) + Render(api). DEIXE AS DUAS VAZIAS. ---
# O deploy hoje e UM container (Dockerfile na raiz): app e API na mesma origem.
# Elas so voltam a valer se alguem separar os dois de novo, e mesmo assim
# afetam apenas /api/audit e /api/volume -- o Nexo nunca passou por elas.
#
# Frontend-only. Vazia = mesma origem.
NEXT_PUBLIC_API_URL=
# Backend-only. Origens externas permitidas em /api/audit. Vazia = so mesma origem.
NEXODOC_ALLOWED_ORIGINS=

# Backend-only. Protects all /api/admin/* endpoints after admin page access is granted.
NEXODOC_ADMIN_TOKEN=

# Backend-only. OpenAI Admin API key used for organization usage/cost endpoints.
OPENAI_ADMIN_KEY=

# Backend-only. Converte ODT -> PDF. HA DOIS CAMINHOS, e so um precisa existir:
#  - LIBREOFFICE_PATH (o container do Dockerfile ja define /usr/bin/soffice);
#  - DOCUMENT_CONVERTER_URL, apontando para o /convert de um servico separado.
# Sem nenhum dos dois o software gera ODT e nao gera PDF -- e ninguem descobre
# ate abrir o volume. /api/saude diz qual dos dois esta valendo.
DOCUMENT_CONVERTER_URL=
LIBREOFFICE_PATH=

# Backend-only. PostgreSQL connection URL, recommended Neon Postgres.
DATABASE_URL=

# Backend-only. Artifact storage metadata. "none" records checksums and sizes only.
NEXODOC_STORAGE_PROVIDER=none
NEXODOC_STORAGE_BASE_URL=
NEXODOC_BACKUP_DIR=./backups

# Optional. Enables the main workspace to read recent persisted audits in production.
# Local development enables this automatically.
NEXODOC_ENABLE_PUBLIC_AUDIT_HISTORY=false

# Backend-only. Fallback do modelo da auditoria profunda (OPENAI_DEEP_MODEL) e,
# quando as chaves de conversa abaixo estao vazias, tambem delas.
OPENAI_MODEL=gpt-5.6-terra

# Backend-only. CONVERSA: agente Nexo e chat pos-auditoria. Chaves proprias para
# que baixar o modelo do chat NAO arraste a auditoria profunda junto.
# Efeito: resposta rapida e barata sobre material que ja foi julgado.
# Valores de effort: none | minimal | low | medium | high | xhigh.
NEXODOC_NEXO_MODEL=gpt-5.6-terra
NEXODOC_AUDIT_CHAT_MODEL=gpt-5.6-terra
NEXODOC_NEXO_REASONING_EFFORT=low
NEXODOC_CHAT_REASONING_EFFORT=low

# Optional. Generic timeout for shared AI calls. Defaults to 90000.
NEXODOC_AI_REQUEST_TIMEOUT_MS=90000

# Backend-only. Modelo da LEITURA DE SELO. E UMA CHAMADA COM VISAO POR PRANCHA,
# e um volume real tem dezenas -- e o gargalo do fluxo inteiro. O mini basta:
# aqui o modelo so COPIA campo de carimbo, quem julga e regra deterministica.
# Subir para gpt-5.5 multiplica tempo e custo sem melhorar o veredito.
NEXODOC_LD_OPENAI_MODEL=gpt-5.6-luna

# Backend-only. OpenAI models used by Organizacao de Volumes. As duas tarefas
# sao de TEXTO e andam juntas no mesmo modelo desde 11/08/2026.
NEXODOC_VOLUME_ANALYSIS_MODEL=gpt-5.6-terra
NEXODOC_VOLUME_SUGGESTION_MODEL=gpt-5.6-terra

# Backend-only. Modelo da CONFERENCIA DE IDENTIDADE DO SELO (endereco, brasao,
# numeracao). Uma unica chamada com visao sobre uma AMOSTRA de folhas -- uma por
# disciplina, no maximo 4 -- e o modelo so LE: o veredito e deterministico
# (server/nexo/selo-identity-core.ts). Por isso um modelo pequeno basta.
# Precisa de visao: escolha um modelo com visao, ou a rota recusa em vez de
# devolver leitura vazia e inventar "sem brasao".
NEXODOC_SELO_CHECK_MODEL=gpt-5.6-luna

# Backend-only. Legacy fallback for the deep validation model when its explicit override is omitted.
OPENAI_VALIDATION_MODEL=

# Backend-only. Auditoria GENERICA (nao-memorial) e os seus doze papeis.
# Saiu de gpt-5.5 em 11/08/2026: o terra iguala o 5.5 nos benchmarks da OpenAI
# por $2/$12 contra $5/$30, e o 5.5 custava o mesmo que o sol -- preco de
# fronteira por geracao anterior. A auditoria de MEMORIAL nao passa por aqui.
OPENAI_STANDARD_MODEL=gpt-5.6-terra
OPENAI_STANDARD_VALIDATION_MODEL=gpt-5.6-terra
OPENAI_DEEP_MODEL=gpt-5.6-terra
OPENAI_DEEP_VALIDATION_MODEL=gpt-5.6-terra

# Backend-only. Isolated model routing for memorial audits.
NEXODOC_AUDIT_MEMORIAL_STANDARD_MODEL=gpt-5.6-terra
NEXODOC_AUDIT_MEMORIAL_DEEP_MODEL=gpt-5.6-sol
NEXODOC_AUDIT_MEMORIAL_DEEP_GLOBAL_MODEL=gpt-5.6-sol
NEXODOC_AUDIT_MEMORIAL_DEEP_VALIDATION_MODEL=gpt-5.6-sol

# Optional. Deep audit throughput controls. Defaults to 24 chunks, 5 parallel chunks.
NEXODOC_MAX_CHUNKS_PER_FILE=24
NEXODOC_CHUNK_CONCURRENCY=5
NEXODOC_CHUNK_TIMEOUT_MS=120000
NEXODOC_DEEP_CHUNK_MAX_OUTPUT_TOKENS=6000

# Optional. Keep false for AI-first audits. Set true only to benchmark legacy local heuristics.
NEXODOC_ENABLE_RULE_BASED_AUDIT=false

# Optional. Whole-document coherence pass (deep analysis only): one LLM call over the
# full document text to catch cross-chapter contradictions (hierarchy, scope, unit/table
# errors) that the sampled global read misses. Findings still pass the anti-hallucination
# evidence gate. Set false to disable. Context size capped by NEXODOC_COHERENCE_CONTEXT_CHARS.
NEXODOC_ENABLE_COHERENCE_PASS=true
NEXODOC_COHERENCE_CONTEXT_CHARS=400000
# Teto de tokens de saída da passada de coerência. Alto de propósito: o documento
# inteiro pode gerar vários achados com evidências longas; se truncar, a etapa vira
# "resposta inválida" e retorna 0 achados. Default 6000.
NEXODOC_COHERENCE_MAX_OUTPUT_TOKENS=6000

# Optional. The deterministic cross-document identity check (município/endereço/obra/código)
# is ALWAYS on. This flag only re-enables the legacy AI-based cross-document comparison
# (more expensive, prone to hallucination) alongside it, for benchmarking. Keep false.
NEXODOC_ENABLE_AI_CROSS_DOCUMENT=false

# Optional. When true, /api/audit returns a simulated response without calling OpenAI.
NEXODOC_MOCK_MODE=false

# Optional. Allows users to activate the demo toggle in production. Defaults to false.
NEXODOC_ALLOW_CLIENT_DEMO=false

# Optional. Mock response delay in milliseconds. Defaults to 3500.
NEXODOC_MOCK_DELAY_MS=3500
