generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum UserRole {
  ADMIN
  USER
}

enum AuditStatus {
  PROCESSING
  COMPLETED
  FAILED
  CANCELED
}

enum AuditFeedbackVerdict {
  CONFIRMED
  FALSE_POSITIVE
  WRONG_SEVERITY
  MISSING_FINDING
}

enum LdDraftStatus {
  DRAFT
  GENERATED
  ARCHIVED
}

enum ProjectStatus {
  ACTIVE
  ARCHIVED
  DELETED
}

enum OrganizationRole {
  OWNER
  ADMIN
  MEMBER
}

enum OrganizationMemberStatus {
  ACTIVE
  INVITED
  DISABLED
}

enum ProjectDocumentStatus {
  ACTIVE
  ARCHIVED
  DELETED
}

enum DocumentArtifactKind {
  COVER_ODT
  COVER_PDF
  COVER_ZIP
  LD_ODT
  LD_PDF
  LD_REPORT
  LD_ZIP
  AUDIT_MARKDOWN
  AUDIT_PDF
  VOLUME_REPORT
  VOLUME_PDF
  VOLUME_ZIP
  OTHER
}

enum DocumentArtifactStatus {
  AVAILABLE
  FAILED
  EXPIRED
  DELETED
}

enum ProjectEventType {
  PROJECT_CREATED
  PROJECT_UPDATED
  STATUS_CHANGED
  PROJECT_ARCHIVED
  PROJECT_DELETED
  DOCUMENT_ADDED
  DOCUMENT_ARCHIVED
  INPUT_UPLOADED
  AUDIT_CREATED
  AUDIT_COMPLETED
  LD_DRAFT_CREATED
  LD_GENERATED
  COVER_GENERATED
  VOLUME_GENERATED
  ARTIFACT_CREATED
  NOTE_ADDED
}

enum AiTaskStatus {
  QUEUED
  RUNNING
  SUCCEEDED
  FAILED
  CANCELED
  NEEDS_REVIEW
}

enum AiTaskPriority {
  LOW
  NORMAL
  HIGH
}

model User {
  id           String    @id @default(cuid())
  name         String
  email        String    @unique
  passwordHash String
  role         UserRole  @default(USER)
  isActive     Boolean   @default(true)
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  sessions     Session[]
  organizationMemberships OrganizationMember[]
  audits       Audit[]
  aiTasks      AiTask[]
  aiUsageEvents AiUsageEvent[]
  projects     Project[]
  projectDocuments ProjectDocument[]
  projectUploads ProjectUpload[]
  documentArtifacts DocumentArtifact[]
  projectEvents ProjectEvent[]
}

model Organization {
  id          String                     @id @default(cuid())
  name        String
  slug        String                     @unique
  ownerEmail  String
  createdAt   DateTime                   @default(now())
  updatedAt   DateTime                   @updatedAt
  archivedAt  DateTime?
  members     OrganizationMember[]
  projects    Project[]

  @@index([ownerEmail, createdAt])
  @@index([archivedAt])
}

model OrganizationMember {
  id             String                   @id @default(cuid())
  organizationId String
  userId         String?
  email          String
  name           String?
  role           OrganizationRole         @default(MEMBER)
  status         OrganizationMemberStatus @default(ACTIVE)
  createdAt      DateTime                 @default(now())
  updatedAt      DateTime                 @updatedAt
  organization   Organization             @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user           User?                    @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@unique([organizationId, email])
  @@index([email, status])
  @@index([userId])
}

model Project {
  id          String        @id @default(cuid())
  organizationId String?
  ownerId     String?
  ownerEmail  String
  ownerName   String?
  code        String        @default("")
  name        String
  client      String        @default("")
  description String        @default("")
  status      ProjectStatus @default(ACTIVE)
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt
  archivedAt  DateTime?
  deletedAt   DateTime?
  organization Organization? @relation(fields: [organizationId], references: [id], onDelete: SetNull)
  owner       User?         @relation(fields: [ownerId], references: [id], onDelete: SetNull)
  audits      Audit[]
  ldDrafts    LdDraft[]
  documents   ProjectDocument[]
  uploads     ProjectUpload[]
  artifacts   DocumentArtifact[]
  events      ProjectEvent[]
  aiTasks     AiTask[]

  @@unique([ownerEmail, code])
  @@index([organizationId, updatedAt])
  @@index([ownerEmail, updatedAt])
  @@index([status, updatedAt])
  @@index([archivedAt])
  @@index([deletedAt])
}

model ProjectDocument {
  id            String                @id @default(cuid())
  projectId     String?
  userId        String?
  userEmail     String
  module        String
  documentType  String
  fileName      String
  mimeType      String                @default("application/pdf")
  sizeBytes     Int?
  pageCount     Int?
  checksumSha256 String?
  status        ProjectDocumentStatus @default(ACTIVE)
  metadata      Json?
  createdAt     DateTime              @default(now())
  updatedAt     DateTime              @updatedAt
  project       Project?              @relation(fields: [projectId], references: [id], onDelete: SetNull)
  user          User?                 @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([projectId, createdAt])
  @@index([userEmail, createdAt])
  @@index([module, createdAt])
  @@index([documentType, createdAt])
  @@index([checksumSha256])
}

model ProjectUpload {
  id             String                @id @default(cuid())
  projectId      String?
  userId         String?
  userEmail      String
  module         String
  source         String                @default("manual")
  fileName       String
  mimeType       String
  sizeBytes      Int?
  pageCount      Int?
  storageProvider String               @default("none")
  storageKey     String?
  checksumSha256 String?
  metadata       Json?
  createdAt      DateTime             @default(now())
  project        Project?             @relation(fields: [projectId], references: [id], onDelete: SetNull)
  user           User?                @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([projectId, createdAt])
  @@index([userEmail, createdAt])
  @@index([module, createdAt])
  @@index([checksumSha256])
  @@index([storageProvider, storageKey])
}

model Session {
  id        String   @id @default(cuid())
  tokenHash String   @unique
  userId    String
  expiresAt DateTime
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
}

model Audit {
  id             String       @id @default(cuid())
  userId         String?
  projectId      String?
  title          String
  projectName    String
  description    String      @default("")
  auditMode      String
  analysisLevel  String      @default("standard")
  status         AuditStatus @default(PROCESSING)
  result         String?
  report         Json?
  error          String?
  elapsedMs      Int?
  totalFindings  Int         @default(0)
  createdAt      DateTime    @default(now())
  completedAt    DateTime?
  user           User?       @relation(fields: [userId], references: [id], onDelete: SetNull)
  project        Project?    @relation(fields: [projectId], references: [id], onDelete: SetNull)
  files          AuditFile[]
  feedback       AuditFeedback[]
  artifacts      DocumentArtifact[]

  @@index([projectId, createdAt])
  @@index([userId, createdAt])
  @@index([status, createdAt])
}

model AuditFeedback {
  id           String               @id @default(cuid())
  auditId      String
  targetKey    String
  findingId    String?
  findingLabel String?
  page         String?
  verdict      AuditFeedbackVerdict
  note         String               @default("")
  createdAt    DateTime             @default(now())
  updatedAt    DateTime             @updatedAt
  audit        Audit                @relation(fields: [auditId], references: [id], onDelete: Cascade)

  @@unique([auditId, targetKey])
  @@index([auditId, createdAt])
  @@index([verdict, createdAt])
}

model AuditFile {
  id                 String   @id @default(cuid())
  auditId            String
  fileName           String
  documentType       String
  pageCount          Int?
  extractedCharCount Int?
  sizeBytes          Int?
  createdAt          DateTime @default(now())
  audit              Audit    @relation(fields: [auditId], references: [id], onDelete: Cascade)

  @@index([auditId])
}

model LdDraft {
  id                 String        @id @default(cuid())
  projectId          String?
  userEmail          String
  userName           String?
  title              String
  projectCode        String
  workName           String
  status             LdDraftStatus @default(DRAFT)
  activeStep         Int           @default(0)
  ldData             Json
  rows               Json
  tomos              Json
  referenceTotal     Int?
  manualTotal        String        @default("")
  uploadedFileNames  Json
  uploadedFileCount  Int           @default(0)
  generatedFileNames Json
  createdAt          DateTime      @default(now())
  updatedAt          DateTime      @updatedAt
  generatedAt        DateTime?
  project            Project?      @relation(fields: [projectId], references: [id], onDelete: SetNull)
  events             LdDraftEvent[]
  artifacts          DocumentArtifact[]

  @@index([projectId, updatedAt])
  @@index([userEmail, updatedAt])
  @@index([status, updatedAt])
}

model LdDraftEvent {
  id         String   @id @default(cuid())
  draftId    String
  actorEmail String
  actorName  String?
  action     String
  summary    String
  details    Json?
  createdAt  DateTime @default(now())
  draft      LdDraft  @relation(fields: [draftId], references: [id], onDelete: Cascade)

  @@index([draftId, createdAt])
  @@index([actorEmail, createdAt])
}

model DocumentArtifact {
  id             String                 @id @default(cuid())
  projectId      String?
  auditId        String?
  ldDraftId      String?
  userId         String?
  userEmail      String
  module         String
  kind           DocumentArtifactKind
  status         DocumentArtifactStatus @default(AVAILABLE)
  fileName       String
  mimeType       String
  sizeBytes      Int?
  storageProvider String                 @default("none")
  storageKey     String?
  downloadUrl    String?
  checksumSha256 String?
  metadata       Json?
  createdAt      DateTime               @default(now())
  updatedAt      DateTime               @updatedAt
  expiresAt      DateTime?
  project        Project?               @relation(fields: [projectId], references: [id], onDelete: SetNull)
  audit          Audit?                 @relation(fields: [auditId], references: [id], onDelete: SetNull)
  ldDraft        LdDraft?               @relation(fields: [ldDraftId], references: [id], onDelete: SetNull)
  user           User?                  @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([projectId, createdAt])
  @@index([auditId, createdAt])
  @@index([ldDraftId, createdAt])
  @@index([userEmail, createdAt])
  @@index([module, createdAt])
  @@index([kind, createdAt])
  @@index([status, createdAt])
  @@index([storageProvider, storageKey])
  @@index([checksumSha256])
}

model ProjectEvent {
  id         String           @id @default(cuid())
  projectId  String
  actorId    String?
  actorEmail String
  actorName  String?
  type       ProjectEventType
  title      String
  summary    String           @default("")
  details    Json?
  createdAt  DateTime         @default(now())
  project    Project          @relation(fields: [projectId], references: [id], onDelete: Cascade)
  actor      User?            @relation(fields: [actorId], references: [id], onDelete: SetNull)

  @@index([projectId, createdAt])
  @@index([actorEmail, createdAt])
  @@index([type, createdAt])
}

model AiTask {
  id               String         @id @default(cuid())
  projectId        String?
  userId           String?
  userEmail        String?
  flow             String
  agent            String
  operation        String
  provider         String?
  model            String?
  status           AiTaskStatus   @default(QUEUED)
  priority         AiTaskPriority @default(NORMAL)
  inputHash        String?
  inputSummary     String?
  outputSummary    String?
  relatedType      String?
  relatedId        String?
  attemptCount     Int            @default(0)
  maxAttempts      Int            @default(1)
  estimatedCostUsd Float?
  actualCostUsd    Float?
  lastError        String?
  metadata         Json?
  createdAt        DateTime       @default(now())
  updatedAt        DateTime       @updatedAt
  startedAt        DateTime?
  finishedAt       DateTime?
  project          Project?       @relation(fields: [projectId], references: [id], onDelete: SetNull)
  user             User?          @relation(fields: [userId], references: [id], onDelete: SetNull)
  usageEvents      AiUsageEvent[]

  @@index([projectId, createdAt])
  @@index([userEmail, createdAt])
  @@index([flow, status, createdAt])
  @@index([agent, status, createdAt])
  @@index([status, priority, createdAt])
  @@index([relatedType, relatedId])
  @@index([inputHash])
}

model AiModelConfig {
  id        String   @id @default(cuid())
  flowId    String   @unique
  label     String
  model     String
  isActive  Boolean  @default(true)
  notes     String   @default("")
  updatedBy String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([isActive, updatedAt])
  @@index([model])
}

/// Os dados de QUEM EMITE — nome, endereço impresso nas pranchas, CREA.
/// Linha única: `id` é sempre "escritorio". O sistema opera sem a linha (é o
/// estado de antes desta tabela); ver `lib/escritorio.ts` para o porquê de o
/// endereço ser dado de sistema e não preferência de tela.
model EscritorioConfig {
  id                 String   @id @default("escritorio")
  nome               String   @default("")
  enderecoImpresso   String   @default("")
  municipio          String   @default("")
  uf                 String   @default("")
  responsavelTecnico String   @default("")
  crea               String   @default("")
  updatedBy          String?
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt
}

model AiUsageEvent {
  id           String   @id @default(cuid())
  flow         String
  aiTaskId     String?
  taskId       String?
  taskLabel    String?
  provider     String
  model        String
  operation    String
  status       String   @default("success")
  inputTokens  Int      @default(0)
  outputTokens Int      @default(0)
  cachedTokens Int      @default(0)
  totalTokens  Int      @default(0)
  estimatedCostUsd Float?
  durationMs   Int?
  metadata     Json?
  error        String?
  userId       String?
  userEmail    String?
  conversationId String?
  createdAt    DateTime @default(now())
  user         User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  aiTask       AiTask?  @relation(fields: [aiTaskId], references: [id], onDelete: SetNull)

  @@index([createdAt])
  @@index([flow, createdAt])
  @@index([aiTaskId, createdAt])
  @@index([taskId, createdAt])
  @@index([userEmail, createdAt])
  @@index([model, createdAt])
  @@index([conversationId])
}

/// A CONVERSA DO NEXO, no servidor.
///
/// Ate agora ela vivia so no IndexedDB do navegador de quem usa. Trocar de
/// maquina perdia o trabalho, limpar dados do site perdia o trabalho sem aviso,
/// e -- o que mais pesa num beta -- nao havia como olhar o que o testador fez.
///
/// `data` guarda o `StoredConversation` inteiro como JSON, e isso e deliberado:
/// esse registro ja e schemaless por projeto (campo novo entra opcional e
/// registro velho segue valido, ver modules/nexo/lib/nexo-db.ts). Normalizar
/// mensagem, selo, ajuste, decisao e achado em tabelas trocaria essa
/// propriedade por uma migracao a cada campo novo -- e o Nexo ainda ganha campo
/// toda semana. As colunas de fora sao so as que a LISTA precisa ler sem abrir
/// o JSON.
///
/// O que NAO esta aqui: os bytes dos ODT/PDF/ZIP gerados. Nao ha provedor de
/// armazenamento (NEXODOC_STORAGE_PROVIDER=none), entao eles seguem no
/// navegador. Ao abrir noutra maquina a conversa volta inteira e os arquivos
/// nao -- e isso precisa APARECER, nao sumir em silencio.
///
/// A chave e o uuid que o cliente ja gera. O dono e o e-mail, como no resto das
/// rotas do Nexo (`session.user.email`), sem FK: o `User` do Postgres so e
/// criado na camada de escrita de artefatos, e uma conversa nao pode depender
/// disso para ser salva.
model NexoConversation {
  id        String   @id
  userEmail String
  title     String
  folderKey String?
  createdAt DateTime
  updatedAt DateTime
  /// Coluna, e nao um `data->>`: e o unico campo do miolo que a LISTA precisa,
  /// e puxar o JSON inteiro de cem conversas para desenhar a barra lateral
  /// arrastaria megabytes por um booleano.
  auditoriaPendente Boolean @default(false)
  /// Mesma razao da coluna acima: a barra lateral separa "Montagem de volumes"
  /// de "Auditorias", e o tipo vive dentro do `data`. Sem coluna, a lista do
  /// servidor nao consegue tipar e TODA conversa cai em "volume" -- e num
  /// primeiro acesso, noutro navegador ou com o cache limpo, o disco local nao
  /// esta la para corrigir. Nulo nos registros gravados antes desta coluna;
  /// `tipoDoResumo` aplica o padrao.
  tipo      String?
  data      Json
  syncedAt  DateTime @default(now())

  @@index([userEmail, updatedAt])
}
