generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum UserRole {
  ADMIN
  USER
}

enum AuditStatus {
  PROCESSING
  COMPLETED
  FAILED
  CANCELED
}

enum AuditFeedbackVerdict {
  CONFIRMED
  FALSE_POSITIVE
  WRONG_SEVERITY
  MISSING_FINDING
}

/// COMO o achado foi encerrado. É eixo diferente do `verdict`, que julga a IA:
/// um achado pode ser PROCEDENTE (verdict) e ter sido encerrado como decisão
/// técnica assumida (resolutionKind). Fundir os dois obrigaria escolher entre
/// registrar o julgamento e registrar o desfecho — que é exatamente o erro que
/// o comentário de `AuditFeedback` explica ter sido evitado antes.
enum FindingResolutionKind {
  FIXED_IN_DOC
  FALSE_POSITIVE
  ACCEPTED_RISK
}

enum LdDraftStatus {
  DRAFT
  GENERATED
  ARCHIVED
}

enum ProjectStatus {
  ACTIVE
  ARCHIVED
  DELETED
}

enum OrganizationRole {
  OWNER
  ADMIN
  MEMBER
}

enum OrganizationMemberStatus {
  ACTIVE
  INVITED
  DISABLED
}

enum ProjectDocumentStatus {
  ACTIVE
  ARCHIVED
  DELETED
}

enum DocumentArtifactKind {
  COVER_ODT
  COVER_PDF
  COVER_ZIP
  LD_ODT
  LD_PDF
  LD_REPORT
  LD_ZIP
  AUDIT_MARKDOWN
  AUDIT_PDF
  VOLUME_REPORT
  VOLUME_PDF
  VOLUME_ZIP
  OTHER
}

enum DocumentArtifactStatus {
  AVAILABLE
  FAILED
  EXPIRED
  DELETED
}

enum ProjectEventType {
  PROJECT_CREATED
  PROJECT_UPDATED
  STATUS_CHANGED
  PROJECT_ARCHIVED
  PROJECT_DELETED
  DOCUMENT_ADDED
  DOCUMENT_ARCHIVED
  INPUT_UPLOADED
  AUDIT_CREATED
  AUDIT_COMPLETED
  LD_DRAFT_CREATED
  LD_GENERATED
  COVER_GENERATED
  VOLUME_GENERATED
  ARTIFACT_CREATED
  NOTE_ADDED
}

enum AiTaskStatus {
  QUEUED
  RUNNING
  SUCCEEDED
  FAILED
  CANCELED
  NEEDS_REVIEW
}

enum AiTaskPriority {
  LOW
  NORMAL
  HIGH
}

model User {
  id                      String               @id @default(cuid())
  name                    String
  email                   String               @unique
  passwordHash            String
  role                    UserRole             @default(USER)
  isActive                Boolean              @default(true)
  createdAt               DateTime             @default(now())
  updatedAt               DateTime             @updatedAt
  sessions                Session[]
  organizationMemberships OrganizationMember[]
  audits                  Audit[]
  aiTasks                 AiTask[]
  aiUsageEvents           AiUsageEvent[]
  projects                Project[]
  projectDocuments        ProjectDocument[]
  projectUploads          ProjectUpload[]
  documentArtifacts       DocumentArtifact[]
  projectEvents           ProjectEvent[]
}

model Organization {
  id             String               @id @default(cuid())
  name           String
  slug           String               @unique
  ownerEmail     String
  createdAt      DateTime             @default(now())
  updatedAt      DateTime             @updatedAt
  archivedAt     DateTime?
  members        OrganizationMember[]
  projects       Project[]
  auditLearnings AuditLearning[]

  @@index([ownerEmail, createdAt])
  @@index([archivedAt])
}

model OrganizationMember {
  id             String                   @id @default(cuid())
  organizationId String
  userId         String?
  email          String
  name           String?
  role           OrganizationRole         @default(MEMBER)
  status         OrganizationMemberStatus @default(ACTIVE)
  /// O GRUPO TÉCNICO da pessoa — arquitetura, estrutural, complementares,
  /// orçamento, externo, diretoria. Texto, e não enum: a lista é do ESCRITÓRIO
  /// (`server/nexo/disciplinas.ts`), e um enum no banco exigiria migration toda
  /// vez que a PROSUL criasse uma equipe.
  ///
  /// Nulo é estado legítimo: quem foi convidado à mão não declara grupo, e a
  /// tela que usa isto — a lista de quem recebe um achado — apenas deixa de
  /// ordenar por afinidade. Nunca esconde ninguém.
  grupo          String?
  createdAt      DateTime                 @default(now())
  updatedAt      DateTime                 @updatedAt
  organization   Organization             @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user           User?                    @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@unique([organizationId, email])
  @@index([email, status])
  @@index([userId])
}

model Project {
  id             String             @id @default(cuid())
  /// O DONO. Era `ownerEmail`; passou a ser o escritorio, e por isso deixou de
  /// aceitar nulo: projeto sem escritorio nao tem quem o libere para emissao.
  organizationId String
  ownerId        String?
  /// Quem CRIOU o projeto — que deixou de ser quem é dono dele. O dono passou a
  /// ser o escritório (`organizationId`); isto aqui é registro, não posse, e é
  /// por isso que nenhuma consulta filtra por ele.
  createdById    String?
  ownerEmail     String
  ownerName      String?
  /// O CENTRO DE CUSTO — "099-25". Perdeu o `@default("")` porque virou
  /// identidade: e por ele que a auditoria acha o projeto a que pertence, e um
  /// vazio casaria com qualquer documento sem codigo legivel.
  code           String
  name           String
  client         String             @default("")
  /// A CHAVE ESTÁVEL do cliente — `criciuma`, `icara`, `chapeco`.
  ///
  /// `client` é texto que humano lê e edita: "CRICIÚMA", "Criciúma" e
  /// "Prefeitura Municipal de Criciúma" são a MESMA prefeitura escritas por três
  /// pessoas. Agrupar o histórico ou pintar uma cor por esse texto daria três
  /// grupos para um cliente só, e a chave é o que não muda quando alguém corrige
  /// a grafia.
  ///
  /// Derivada por [[lib/cliente-do-projeto.ts]], nunca digitada. Vazia é estado
  /// legítimo: projeto sem cliente é projeto sem cliente, e inventar uma chave o
  /// faria agrupar com quem não é dele.
  clientKey      String             @default("")
  description    String             @default("")
  status         ProjectStatus      @default(ACTIVE)
  createdAt      DateTime           @default(now())
  updatedAt      DateTime           @updatedAt
  archivedAt     DateTime?
  deletedAt      DateTime?
  /// `Restrict`, e nao `SetNull`: com o escritorio sendo dono, apagar a
  /// organizacao deixaria projeto orfao — que e exatamente o estado que este
  /// trabalho eliminou.
  organization   Organization       @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  owner          User?              @relation(fields: [ownerId], references: [id], onDelete: SetNull)
  audits         Audit[]
  ldDrafts       LdDraft[]
  documents      ProjectDocument[]
  uploads        ProjectUpload[]
  artifacts      DocumentArtifact[]
  events         ProjectEvent[]
  aiTasks        AiTask[]
  nexoConversations NexoConversation[]

  /// O codigo do projeto e unico no ESCRITORIO, e era unico por dono: dois
  /// projetistas podiam cadastrar "099-25" cada um, e o banco achava normal.
  @@unique([organizationId, code])
  @@index([organizationId, updatedAt])
  @@index([organizationId, clientKey])
  @@index([status, updatedAt])
  @@index([archivedAt])
  @@index([deletedAt])
}

model ProjectDocument {
  id             String                @id @default(cuid())
  projectId      String?
  userId         String?
  userEmail      String
  module         String
  documentType   String
  fileName       String
  mimeType       String                @default("application/pdf")
  sizeBytes      Int?
  pageCount      Int?
  checksumSha256 String?
  status         ProjectDocumentStatus @default(ACTIVE)
  metadata       Json?
  createdAt      DateTime              @default(now())
  updatedAt      DateTime              @updatedAt
  project        Project?              @relation(fields: [projectId], references: [id], onDelete: SetNull)
  user           User?                 @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([projectId, createdAt])
  @@index([userEmail, createdAt])
  @@index([module, createdAt])
  @@index([documentType, createdAt])
  @@index([checksumSha256])
}

model ProjectUpload {
  id              String   @id @default(cuid())
  projectId       String?
  userId          String?
  userEmail       String
  module          String
  source          String   @default("manual")
  fileName        String
  mimeType        String
  sizeBytes       Int?
  pageCount       Int?
  storageProvider String   @default("none")
  storageKey      String?
  checksumSha256  String?
  metadata        Json?
  createdAt       DateTime @default(now())
  project         Project? @relation(fields: [projectId], references: [id], onDelete: SetNull)
  user            User?    @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([projectId, createdAt])
  @@index([userEmail, createdAt])
  @@index([module, createdAt])
  @@index([checksumSha256])
  @@index([storageProvider, storageKey])
}

model Session {
  id        String   @id @default(cuid())
  tokenHash String   @unique
  userId    String
  expiresAt DateTime
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
}

model Audit {
  id            String             @id @default(cuid())
  userId        String?
  projectId     String?
  title         String
  projectName   String
  description   String             @default("")
  auditMode     String
  analysisLevel String             @default("standard")
  status        AuditStatus        @default(PROCESSING)
  result        String?
  report        Json?
  error         String?
  elapsedMs     Int?
  totalFindings Int                @default(0)
  createdAt     DateTime           @default(now())
  completedAt   DateTime?
  user          User?              @relation(fields: [userId], references: [id], onDelete: SetNull)
  project       Project?           @relation(fields: [projectId], references: [id], onDelete: SetNull)
  files         AuditFile[]
  feedback      AuditFeedback[]
  artifacts     DocumentArtifact[]
  texts         AuditText[]

  @@index([projectId, createdAt])
  @@index([userId, createdAt])
  @@index([status, createdAt])
}

/// O que o engenheiro decidiu sobre um achado. Duas perguntas DIFERENTES na
/// mesma linha, e é de propósito que sejam colunas separadas:
///
///  - `verdict`: o achado procede? (procedente / falso positivo / severidade
///    errada). É um julgamento sobre a AUDITORIA, e alimenta o benchmark;
///  - `resolvedAt`: já foi corrigido no memorial? É o estado do TRABALHO.
///
/// Um achado procedente e já corrigido é o caso normal — as duas coisas valem
/// ao mesmo tempo. Ter emendado "resolvido" como um quarto valor do enum teria
/// forçado escolher entre registrar o julgamento e registrar o progresso, e
/// marcar como corrigido apagaria a avaliação que alimenta o benchmark.
///
/// Por isso `verdict` passou a ser opcional: marcar corrigido sem julgar é
/// legítimo, e era o único caminho que a coluna obrigatória bloqueava.
///
/// ESTA LINHA VIROU O ACHADO COMPARTILHADO. Nasceu para guardar o julgamento da
/// IA, e hoje guarda também a atribuição, o aviso, o desfecho e — desde o
/// multiplayer — a âncora da conversa e dos envolvidos. O nome ficou pequeno.
///
/// NÃO foi renomeada de propósito: migração de tabela por vaidade de
/// nomenclatura, num sistema no ar, é risco sem retorno.
model AuditFeedback {
  id             String                 @id @default(cuid())
  auditId        String
  targetKey      String
  findingId      String?
  findingLabel   String?
  page           String?
  verdict        AuditFeedbackVerdict?
  /// Quando foi marcado como corrigido. Nulo = não corrigido — o instante fica
  /// registrado porque "quando" é a pergunta seguinte de quem revisa em dupla.
  resolvedAt     DateTime?
  /// A identidade do achado ENTRE VERSÕES (`chaveEntreVersoes`), gravada no
  /// instante do envio. O `targetKey` guarda `finding:INC-014`, e o `INC-014` é
  /// POSICIONAL: na reauditoria o mesmo achado vira `INC-009` sem nada ter
  /// acontecido com ele. Sem isto, a linhagem entre pareceres não teria como
  /// reencontrar esta pendência — e o dado só faltaria muitos meses depois.
  fingerprint    String?
  /// A QUEM foi enviado. E-mail, e não id de usuário: dá para mandar trabalho a
  /// quem ainda não entrou no sistema, e é no primeiro dia que a coordenação
  /// mais distribui. Mesmo motivo do convite em `OrganizationMember`.
  assigneeEmail  String?
  assignedById   String?
  assignedAt     DateTime?
  /// Quando o AVISO POR E-MAIL desta atribuição saiu. Nulo = a pessoa foi
  /// atribuída e ainda não foi avisada.
  ///
  /// Mora aqui, e não numa tabela de notificação, pelo mesmo motivo que a
  /// atribuição mora aqui: uma segunda linha para o mesmo achado discordaria
  /// da primeira no dia em que alguém reatribuísse por um dos caminhos.
  ///
  /// REATRIBUIR ZERA ESTE CAMPO (ver `atribuirAchados`). Sem isso, o achado que
  /// sai do Milton para a Carla continuaria "já avisado" — e a Carla nunca
  /// receberia o e-mail, porque a linha diz que o aviso já saiu. Saiu para
  /// outra pessoa.
  notifiedAt     DateTime?
  resolutionKind FindingResolutionKind?
  resolvedById   String?
  note           String                 @default("")
  createdAt      DateTime               @default(now())
  updatedAt      DateTime               @updatedAt
  audit          Audit                  @relation(fields: [auditId], references: [id], onDelete: Cascade)
  mensagens      AuditFindingMessage[]
  envolvidos     AuditFindingWatcher[]

  @@unique([auditId, targetKey])
  @@index([auditId, createdAt])
  @@index([verdict, createdAt])
  /// A consulta da home: o que está comigo e ainda não foi resolvido.
  @@index([assigneeEmail, resolvedAt])
}

model AuditFile {
  id                 String   @id @default(cuid())
  auditId            String
  fileName           String
  documentType       String
  pageCount          Int?
  extractedCharCount Int?
  sizeBytes          Int?
  /// O ARQUIVO GUARDADO a que esta linha se refere — a chave de [[StoredFile]].
  ///
  /// Fica aqui, e não numa consulta ao `ProjectUpload` por
  /// `metadata->>'auditId'`: `AuditFile` já É a lista dos arquivos desta
  /// auditoria, e amarrar a busca a uma chave dentro de um JSON faria a tela
  /// depender de um formato que nada garante.
  ///
  /// Nulo nas auditorias anteriores a este trabalho — os bytes delas não foram
  /// guardados, e a tela diz isso em vez de esconder o botão.
  checksumSha256     String?
  createdAt          DateTime @default(now())
  audit              Audit    @relation(fields: [auditId], references: [id], onDelete: Cascade)

  @@index([auditId])
}

/// O texto do documento auditado, guardado para o chat pós-parecer poder RELER
/// o memorial em vez de falar de cor sobre o parecer. Sem isto o chat nunca viu
/// o documento — só o JSON dos achados, e o prompt dele mandava literalmente
/// "não diga que releu o PDF".
///
/// Guardamos o TEXTO, não o PDF: os bytes vivem no navegador e o provedor de
/// blob está em "none" (`lib/file-storage.ts`). ~173 KB para 73 páginas.
model AuditText {
  id        String   @id @default(cuid())
  auditId   String
  fileName  String
  /// Uma entrada por página: { page, text }. É daqui que sai o número da página
  /// que o chat cita — o modelo nunca o inventa.
  pages     Json
  /// O ÍNDICE por capítulo (`chunkPdfByChapter`), SEM o texto: título, página
  /// inicial, final e nº de chars. Guardar o texto aqui também dobraria o
  /// armazenamento — o texto do capítulo se reconstrói das páginas.
  capitulos Json
  charCount Int
  createdAt DateTime @default(now())
  audit     Audit    @relation(fields: [auditId], references: [id], onDelete: Cascade)

  @@index([auditId])
}

model LdDraft {
  id                 String             @id @default(cuid())
  projectId          String?
  userEmail          String
  userName           String?
  title              String
  projectCode        String
  workName           String
  status             LdDraftStatus      @default(DRAFT)
  activeStep         Int                @default(0)
  ldData             Json
  rows               Json
  tomos              Json
  referenceTotal     Int?
  manualTotal        String             @default("")
  uploadedFileNames  Json
  uploadedFileCount  Int                @default(0)
  generatedFileNames Json
  createdAt          DateTime           @default(now())
  updatedAt          DateTime           @updatedAt
  generatedAt        DateTime?
  project            Project?           @relation(fields: [projectId], references: [id], onDelete: SetNull)
  events             LdDraftEvent[]
  artifacts          DocumentArtifact[]

  @@index([projectId, updatedAt])
  @@index([userEmail, updatedAt])
  @@index([status, updatedAt])
}

model LdDraftEvent {
  id         String   @id @default(cuid())
  draftId    String
  actorEmail String
  actorName  String?
  action     String
  summary    String
  details    Json?
  createdAt  DateTime @default(now())
  draft      LdDraft  @relation(fields: [draftId], references: [id], onDelete: Cascade)

  @@index([draftId, createdAt])
  @@index([actorEmail, createdAt])
}

model DocumentArtifact {
  id              String                 @id @default(cuid())
  projectId       String?
  auditId         String?
  ldDraftId       String?
  userId          String?
  userEmail       String
  module          String
  kind            DocumentArtifactKind
  status          DocumentArtifactStatus @default(AVAILABLE)
  fileName        String
  mimeType        String
  sizeBytes       Int?
  storageProvider String                 @default("none")
  storageKey      String?
  downloadUrl     String?
  checksumSha256  String?
  metadata        Json?
  createdAt       DateTime               @default(now())
  updatedAt       DateTime               @updatedAt
  expiresAt       DateTime?
  project         Project?               @relation(fields: [projectId], references: [id], onDelete: SetNull)
  audit           Audit?                 @relation(fields: [auditId], references: [id], onDelete: SetNull)
  ldDraft         LdDraft?               @relation(fields: [ldDraftId], references: [id], onDelete: SetNull)
  user            User?                  @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([projectId, createdAt])
  @@index([auditId, createdAt])
  @@index([ldDraftId, createdAt])
  @@index([userEmail, createdAt])
  @@index([module, createdAt])
  @@index([kind, createdAt])
  @@index([status, createdAt])
  @@index([storageProvider, storageKey])
  @@index([checksumSha256])
}

model ProjectEvent {
  id         String           @id @default(cuid())
  projectId  String
  actorId    String?
  actorEmail String
  actorName  String?
  type       ProjectEventType
  title      String
  summary    String           @default("")
  details    Json?
  createdAt  DateTime         @default(now())
  project    Project          @relation(fields: [projectId], references: [id], onDelete: Cascade)
  actor      User?            @relation(fields: [actorId], references: [id], onDelete: SetNull)

  @@index([projectId, createdAt])
  @@index([actorEmail, createdAt])
  @@index([type, createdAt])
}

model AiTask {
  id               String         @id @default(cuid())
  projectId        String?
  userId           String?
  userEmail        String?
  flow             String
  agent            String
  operation        String
  provider         String?
  model            String?
  status           AiTaskStatus   @default(QUEUED)
  priority         AiTaskPriority @default(NORMAL)
  inputHash        String?
  inputSummary     String?
  outputSummary    String?
  relatedType      String?
  relatedId        String?
  attemptCount     Int            @default(0)
  maxAttempts      Int            @default(1)
  estimatedCostUsd Float?
  actualCostUsd    Float?
  lastError        String?
  metadata         Json?
  createdAt        DateTime       @default(now())
  updatedAt        DateTime       @updatedAt
  startedAt        DateTime?
  finishedAt       DateTime?
  project          Project?       @relation(fields: [projectId], references: [id], onDelete: SetNull)
  user             User?          @relation(fields: [userId], references: [id], onDelete: SetNull)
  usageEvents      AiUsageEvent[]

  @@index([projectId, createdAt])
  @@index([userEmail, createdAt])
  @@index([flow, status, createdAt])
  @@index([agent, status, createdAt])
  @@index([status, priority, createdAt])
  @@index([relatedType, relatedId])
  @@index([inputHash])
}

model AiModelConfig {
  id        String   @id @default(cuid())
  flowId    String   @unique
  label     String
  model     String
  isActive  Boolean  @default(true)
  notes     String   @default("")
  updatedBy String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([isActive, updatedAt])
  @@index([model])
}

/// A cotação do dólar DECLARADA à mão, com data e autor.
/// Linha única: `id` é sempre "cambio". Não é buscada de API de propósito —
/// ver o docblock de `lib/cambio.ts`. Sem a linha, o painel fica em dólar.
model CambioConfig {
  id           String   @id @default("cambio")
  valor        Float    @default(0)
  declaradaEm  DateTime @default(now())
  declaradaPor String   @default("")
  updatedAt    DateTime @updatedAt
}

/// As metas do painel de Quality, declaradas à mão.
/// Linha única ("meta-qualidade"). Sem meta de fábrica: um número chutado aqui
/// faria o painel aprovar e reprovar sozinho — ver `lib/meta-de-qualidade.ts`.
model MetaQualidadeConfig {
  id               String   @id @default("meta-qualidade")
  falsoPositivoMax Float    @default(0)
  coberturaMin     Float    @default(0)
  declaradaEm      DateTime @default(now())
  declaradaPor     String   @default("")
  updatedAt        DateTime @updatedAt
}

model AiUsageEvent {
  id               String   @id @default(cuid())
  flow             String
  aiTaskId         String?
  taskId           String?
  taskLabel        String?
  provider         String
  model            String
  operation        String
  status           String   @default("success")
  inputTokens      Int      @default(0)
  outputTokens     Int      @default(0)
  cachedTokens     Int      @default(0)
  totalTokens      Int      @default(0)
  estimatedCostUsd Float?
  durationMs       Int?
  metadata         Json?
  error            String?
  userId           String?
  userEmail        String?
  conversationId   String?
  createdAt        DateTime @default(now())
  user             User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  aiTask           AiTask?  @relation(fields: [aiTaskId], references: [id], onDelete: SetNull)

  @@index([createdAt])
  @@index([flow, createdAt])
  @@index([aiTaskId, createdAt])
  @@index([taskId, createdAt])
  @@index([userEmail, createdAt])
  @@index([model, createdAt])
  @@index([conversationId])
}

/// A CONVERSA DO NEXO, no servidor.
///
/// Ate agora ela vivia so no IndexedDB do navegador de quem usa. Trocar de
/// maquina perdia o trabalho, limpar dados do site perdia o trabalho sem aviso,
/// e -- o que mais pesa num beta -- nao havia como olhar o que o testador fez.
///
/// `data` guarda o `StoredConversation` inteiro como JSON, e isso e deliberado:
/// esse registro ja e schemaless por projeto (campo novo entra opcional e
/// registro velho segue valido, ver modules/nexo/lib/nexo-db.ts). Normalizar
/// mensagem, selo, ajuste, decisao e achado em tabelas trocaria essa
/// propriedade por uma migracao a cada campo novo -- e o Nexo ainda ganha campo
/// toda semana. As colunas de fora sao so as que a LISTA precisa ler sem abrir
/// o JSON.
///
/// O que NAO esta aqui: os bytes dos ODT/PDF/ZIP gerados. Nao ha provedor de
/// armazenamento (NEXODOC_STORAGE_PROVIDER=none), entao eles seguem no
/// navegador. Ao abrir noutra maquina a conversa volta inteira e os arquivos
/// nao -- e isso precisa APARECER, nao sumir em silencio.
///
/// A chave e o uuid que o cliente ja gera. O dono e o e-mail, como no resto das
/// rotas do Nexo (`session.user.email`), sem FK: o `User` do Postgres so e
/// criado na camada de escrita de artefatos, e uma conversa nao pode depender
/// disso para ser salva.
model NexoConversation {
  id                String   @id
  userEmail         String
  title             String
  folderKey         String?
  /// O ENDEREÇO da conversa — o `Project` a que ela pertence.
  ///
  /// `folderKey` era a identidade, e era uma string derivada no navegador: a
  /// barra lateral agrupava por ela enquanto a home e a fila agrupavam por chave
  /// estrangeira. Dois conceitos de "projeto" que não conversavam, e o sintoma
  /// era todo memorial auditado caindo num balde chamado "Sem código no
  /// carimbo" — sendo que memorial não tem carimbo.
  ///
  /// `folderKey` continua existindo como cache de EXIBIÇÃO; a identidade é esta
  /// coluna.
  ///
  /// NULO É LEGÍTIMO — é a conversa "a endereçar": memorial sem código legível,
  /// ou conversa que ainda não recebeu documento nenhum.
  ///
  /// `SetNull` como no `Audit`: apagar o projeto não pode apagar a conversa, que
  /// guarda o trabalho de quem a escreveu.
  projectId         String?
  project           Project? @relation(fields: [projectId], references: [id], onDelete: SetNull)
  createdAt         DateTime
  updatedAt         DateTime
  /// Coluna, e nao um `data->>`: e o unico campo do miolo que a LISTA precisa,
  /// e puxar o JSON inteiro de cem conversas para desenhar a barra lateral
  /// arrastaria megabytes por um booleano.
  auditoriaPendente Boolean  @default(false)
  /// Mesma razao da coluna acima: a barra lateral separa "Montagem de volumes"
  /// de "Auditorias", e o tipo vive dentro do `data`. Sem coluna, a lista do
  /// servidor nao consegue tipar e TODA conversa cai em "volume" -- e num
  /// primeiro acesso, noutro navegador ou com o cache limpo, o disco local nao
  /// esta la para corrigir. Nulo nos registros gravados antes desta coluna;
  /// `tipoDoResumo` aplica o padrao.
  tipo              String?
  data              Json
  syncedAt          DateTime @default(now())

  @@index([userEmail, updatedAt])
  @@index([projectId, updatedAt])
}

/// O QUE A AUDITORIA APRENDEU -- as preferencias, regras e correcoes que o
/// escritorio ensinou e que entram no prompt de toda auditoria.
///
/// Vivia num JSON em `process.cwd()/data/`, e o container da Render nao tem
/// disco persistente declarado: cada deploy zerava o acervo. Com `autoDeploy`
/// ligado, isso acontecia a cada push -- as telas gravavam, a proxima subida
/// apagava, e nada no produto acusava a perda.
///
/// Sem relacao com `User`: aprendizado e do ESCRITORIO, nao de quem o digitou.
/// Amarra-lo a uma conta faria o acervo encolher quando alguem saisse da
/// empresa, que e o oposto do que ele existe para fazer.
model AuditLearning {
  id             String       @id @default(cuid())
  organizationId String
  title          String
  content        String
  /// `preference` | `rule` | `example` | `correction`. Texto, e nao enum: os
  /// tipos sao vocabulario de produto e mudam sem merecer uma migracao.
  type           String       @default("preference")
  /// `global` | `memorial` | `volume`.
  scope          String       @default("global")
  /// `active` | `paused`. Pausado continua no acervo e sai do prompt.
  status         String       @default("active")
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @default(now())
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  /// A leitura quente: os ativos de um escopo, do mais recente para o mais
  /// antigo. E exatamente o que `listAuditLearnings` pede a cada auditoria.
  @@index([organizationId, status, scope, updatedAt])
  @@index([organizationId, updatedAt])
}

/// Uma linha da CONVERSA de um achado — o que uma pessoa escreveu, ou o que o
/// sistema registrou. As duas coisas na MESMA cronologia, e isso é decisão.
///
/// Uma tabela de mensagens e outra de eventos produziriam duas linhas do tempo
/// que a tela teria que fundir, e que poderiam discordar. Ver
/// [[lib/conversa-do-achado.ts]], que monta a leitura.
model AuditFindingMessage {
  id          String        @id @default(cuid())
  feedbackId  String
  /// `comentario` | `atribuiu` | `reatribuiu` | `envolveu` | `desenvolveu` |
  /// `resolveu` | `reabriu`.
  ///
  /// Texto e não enum: o vocabulário é de produto e cresce sem merecer uma
  /// migração — mesma razão de `AuditLearning.type`. Quem lê trata `kind`
  /// desconhecido com uma frase genérica, nunca sumindo com a linha.
  kind        String
  /// E-mail de quem falou. Como no resto do módulo, é o e-mail que identifica —
  /// dá para ter sido convidado e ainda não ter conta.
  authorEmail String
  authorId    String?
  /// O que a pessoa escreveu. Vazio nos eventos de sistema — e NÃO vazio na
  /// atribuição com recado: o recado é a primeira fala da conversa, e a linha
  /// carrega o evento e a fala ao mesmo tempo.
  body        String        @default("")
  /// `{de, deNome, para, paraNome}` na reatribuição; `{desfecho}` no fecho. É o
  /// que a frase precisa para se montar sem uma segunda consulta — e o que a
  /// mantém verdadeira quando a pessoa citada sai do escritório depois.
  details     Json?
  createdAt   DateTime      @default(now())
  feedback    AuditFeedback @relation(fields: [feedbackId], references: [id], onDelete: Cascade)

  @@index([feedbackId, createdAt])
}

/// Quem ACOMPANHA o achado sem responder por ele.
///
/// O responsável é UM, e continua em `AuditFeedback.assigneeEmail` — a coluna
/// indexada que a home consulta em `pendenciasDe()`. Com N responsáveis iguais,
/// "o achado está resolvido quando quem fecha?" não teria resposta que não
/// perdesse achado. A assimetria é a decisão: um responde, os outros acompanham.
model AuditFindingWatcher {
  id         String        @id @default(cuid())
  feedbackId String
  email      String
  /// POR PESSOA, e não uma coluna só no achado.
  ///
  /// O docblock de `AuditFeedback.notifiedAt` explica por quê: reatribuir zera o
  /// aviso, senão a Carla herda o "já avisado" que era do Milton e nunca fica
  /// sabendo. Com N pessoas, esse estado é de cada uma.
  notifiedAt DateTime?
  addedById  String?
  addedAt    DateTime      @default(now())
  feedback   AuditFeedback @relation(fields: [feedbackId], references: [id], onDelete: Cascade)

  @@unique([feedbackId, email])
  @@index([email, notifiedAt])
}

/// O ARQUIVO, de verdade — os bytes.
///
/// `lib/file-storage.ts` existia desde sempre e NUNCA gravou nada: 64 linhas que
/// calculam chave, checksum e URL, e devolvem `storageProvider: "none"`. Os
/// bytes do memorial chegavam ao servidor (`audit-persistence` passa
/// `file.buffer`) e eram descartados. Resultado: quem recebia um achado por
/// e-mail não tinha como conferi-lo no documento — e uma auditoria que não se
/// pode conferir é uma afirmação.
///
/// POSTGRES, E NÃO S3. Decidido em 01/09/2026 sabendo do custo: sem vendor novo,
/// sem credencial nova, no mesmo backup do resto. `file-storage.ts` continua
/// sendo a costura, então trocar de provedor depois não é reescrever.
///
/// SÓ O MEMORIAL AUDITADO. Pranchas e volumes ficam de fora, e é o que segura o
/// custo: memorial real tem 1,6 a 5,2 MB; um volume passa de 20 MB com 88% de
/// JPEG.
model StoredFile {
  /// A CHAVE É O CONTEÚDO. Reauditar o mesmo memorial não grava de novo, e
  /// `ProjectUpload.checksumSha256` já é calculado e já aponta para cá.
  ///
  /// Cinco revisões assinadas do mesmo memorial são cinco arquivos DIFERENTES e
  /// ocupam cinco vagas — é o comportamento certo: o parecer de cada uma cita as
  /// páginas da sua.
  checksumSha256 String   @id
  /// O escopo de quem pode ler, na mesma régua de [[lib/audit-access.ts]].
  organizationId String
  mimeType       String
  sizeBytes      Int
  bytes          Bytes
  createdAt      DateTime @default(now())

  /// Sustenta a regra de expurgo no dia em que ela existir. Não há nenhuma hoje.
  @@index([organizationId, createdAt])
}
